#!/usr/bin/env bash
# test-quality producer — run a committed gate ledger through the vendored unlazy executor and emit
# the head-bound `<!-- test-quality:PASS@<sha> -->` marker ONLY on a real ALL-MET run. The marker the
# pr_gate merge check reads (Deliverable L) is now earned by real CHECK/EXPECT execution + a
# negative-control mutation the ledger authors — not a paste-judged assertion.
#
# Usage:  bin/test-quality-run <ledger.md>
# Env:    TQ_HEAD_SHA        override `git rev-parse HEAD` (tests / detached contexts)
#         GATE_CHECK         path to gate-check.mjs (default: alongside this script, bin/gate/)
#         UNLAZY_APPROVAL_DIR  approval store — MUST resolve OUTSIDE the ledger root (default
#                            ~/.unlazy/approved, which is outside any repo). See bin/gate/README.md.
# Exit:   0 all gates met (marker printed to stdout) · 1/2 unmet/parse (no marker) · 3 visible
#         infra failure (missing node/executor/sha) — NEVER a silent pass.
set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
GATE_CHECK="${GATE_CHECK:-$SELF_DIR/gate/gate-check.mjs}"

die3() { printf 'test-quality-run: %s\n' "$1" >&2; exit 3; }

ledger="${1:-}"
[ -n "$ledger" ] || { printf 'usage: test-quality-run <ledger.md>\n' >&2; exit 2; }
[ -f "$ledger" ] || { printf 'test-quality-run: ledger not found: %s\n' "$ledger" >&2; exit 2; }

# M6 — a missing/too-old runtime must fail VISIBLY, never silently emit no-marker-but-exit-0.
command -v node >/dev/null 2>&1 || die3 "node runtime not found (need Node >= 16)"
node_major="$(node -e 'process.stdout.write(String(process.versions.node.split(".")[0]))' 2>/dev/null || true)"
case "$node_major" in ''|*[!0-9]*) die3 "could not determine node version" ;; esac
[ "$node_major" -ge 16 ] || die3 "node $node_major too old (need >= 16)"
[ -f "$GATE_CHECK" ] || die3 "gate executor not found: $GATE_CHECK"

sha="${TQ_HEAD_SHA:-$(git rev-parse HEAD 2>/dev/null || true)}"
[ -n "$sha" ] || die3 "no HEAD sha (not a git repo? pass TQ_HEAD_SHA)"

# Execute the ledger. A test-quality ledger's CHECKs (`bin/test-lock`, `hooks/…`, `tests/…`) are
# REPO-ROOT-relative, so anchor --root AND --cwd at the ledger's git toplevel and run the CHECKs from
# there (gate-check's explicit-ledger default would otherwise cwd to the ledger's own dir — #584).
# Fall back to the ledger dir for a self-contained ledger outside any repo. Pass the ledger ABSOLUTE
# so gate-check never double-joins it against --root. The approval store (default ~/.unlazy/approved)
# stays outside --root, satisfying gate-check's outside-root rule.
ledger_dir="$(cd "$(dirname "$ledger")" && pwd)"
root="$(git -C "$ledger_dir" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$ledger_dir")"
node "$GATE_CHECK" --approve --root "$root" --cwd "$root" "$ledger_dir/$(basename "$ledger")" >&2
rc=$?

if [ "$rc" -eq 0 ]; then
  printf '<!-- test-quality:PASS@%s -->\n' "$sha"
  exit 0
fi
# Unmet / parse — no marker. Surface the executor's code (1 unmet, 2 parse) so the caller sees why.
printf 'test-quality-run: gates NOT all met (gate-check exit %d); no marker emitted.\n' "$rc" >&2
exit "$rc"
