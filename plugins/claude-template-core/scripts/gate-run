#!/usr/bin/env bash
# gate-run — canonical-env wrapper around bin/gate/gate-check.mjs.
#
# The point: a human ARMs an unattended run once (`gate-run arm` -> gate-check --approve, reviews each
# CHECK), and the autonomous loop later re-verifies pre-approved gates (`gate-run verify` -> --reverify)
# with NO human. That only works if the approval identity — which binds cwd+shell+PATH — is byte-identical
# at arm-time and verify-time. So this wrapper PINS a canonical env (deterministic PATH from the node
# location + standard dirs, UNLAZY_SHELL, a stable approval dir outside the repo) the SAME way every run.
# Same machine, same pinned env => the arm-time approval transfers to unattended verify. (Not a CI oracle:
# a different machine has a different node dir, so approvals don't transfer there — by design.)
#
#   gate-run arm    <ledger>   # gate-check --approve  (human reviews + approves + first run)
#   gate-run verify <ledger>   # gate-check --reverify (re-runs ONLY already-approved gates; no approve)
#   gate-run status <ledger>   # gate-check --status   (parse-only; never executes)
set -uo pipefail

usage() { echo "usage: gate-run <arm|verify|status> <ledger>" >&2; exit 2; }

mode="${1:-}"; ledger="${2:-}"
[ -n "$mode" ] && [ -n "$ledger" ] || usage
case "$mode" in arm|verify|status) ;; *) usage ;; esac

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
GATE_CHECK="${GATE_CHECK:-$SELF_DIR/gate/gate-check.mjs}"

# --root/--cwd = the ledger's git toplevel, else its containing dir (a ledger may live in a scratch tree).
ledger_dir="$(cd "$(dirname "$ledger")" 2>/dev/null && pwd)" || { echo "gate-run: cannot resolve ledger dir for $ledger" >&2; exit 2; }
root="$(git -C "$ledger_dir" rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$root" ] || root="$ledger_dir"

# --- node required; a missing/old executor must fail VISIBLY, never a silent pass (M6) ---
if ! command -v node >/dev/null 2>&1; then
  echo "gate-run: node not found on PATH — cannot run gates (Node >=16 required)." >&2; exit 3
fi
if [ ! -f "$GATE_CHECK" ]; then
  echo "gate-run: gate-check executor not found at $GATE_CHECK" >&2; exit 3
fi

# --- canonical env (identical at arm-time and verify-time => matching approval identity) ---
# PATH is a deterministic function of the node location (the only non-standard tool dir on macOS/Linux)
# plus fixed system dirs plus the repo's bin. git and coreutils live under /usr/bin:/bin. Gate CHECKs
# must use only tools reachable from THIS PATH — see the `gates` skill.
NODE_DIR="$(cd "$(dirname "$(command -v node)")" && pwd)"
# ~/.local/bin carries the `claude-template` dispatcher so a CHECK may invoke a plugin-shipped helper
# (e.g. `claude-template fanout-status`) reproducibly — $HOME is stable arm→verify, so identity holds.
export PATH="$NODE_DIR:/usr/bin:/bin:$HOME/.local/bin:$root/bin"
export UNLAZY_SHELL="/bin/sh"
: "${UNLAZY_APPROVAL_DIR:=$HOME/.unlazy/approved}"; export UNLAZY_APPROVAL_DIR

case "$mode" in
  arm)    exec node "$GATE_CHECK" --approve  --root "$root" --cwd "$root" "$ledger" ;;
  verify) exec node "$GATE_CHECK" --reverify --root "$root" --cwd "$root" "$ledger" ;;
  status) exec node "$GATE_CHECK" --status   --root "$root" "$ledger" ;;  # --cwd is execution-only; --status rejects it
esac
