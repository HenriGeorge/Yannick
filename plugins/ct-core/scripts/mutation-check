#!/usr/bin/env bash
# mutation-check — the negative control for a test-quality gate (unlazy references/gates.md:99).
# Proves a test can actually FAIL: break one covered line, run the test expecting it to go RED, then
# ALWAYS restore the file. Prints a success-only marker so it can back an EXPECT: line.
#
# Usage:  bin/mutation-check <file> <sed-break-expr> -- <test-cmd...>
#   <file>            a source file the test covers
#   <sed-break-expr>  a `sed` program that mutates the covered behaviour (e.g. 's/return true/return false/')
#   <test-cmd...>     the test that MUST pass on clean code and MUST fail on the mutated code
#
# Exit:  0 mutation proven (green on clean code, RED while broken, file restored) + `mutation-proven: RED`
#        1 the test STILL PASSED with broken code — the test cannot detect the mutation (a false test)
#        2 usage / snapshot failed / test NOT green on clean code / no-op mutation (visible, never a silent pass)
set -uo pipefail

file="${1:-}"; expr="${2:-}"; shift 2 || { printf 'usage: mutation-check <file> <sed-expr> -- <test-cmd...>\n' >&2; exit 2; }
[ "${1:-}" = "--" ] && shift
[ -n "$file" ] && [ -f "$file" ] || { printf 'mutation-check: file not found: %s\n' "$file" >&2; exit 2; }
[ -n "$expr" ] || { printf 'mutation-check: empty sed break expression\n' >&2; exit 2; }
[ "$#" -gt 0 ] || { printf 'mutation-check: no test command\n' >&2; exit 2; }

snap="$(mktemp)"
# Guard the snapshot: an unchecked cp that failed would arm the trap over an EMPTY snapshot and
# wipe the source on restore. Fail loud BEFORE arming the trap or mutating anything.
cp "$file" "$snap" || { printf 'mutation-check: could not snapshot %s — aborting, file untouched\n' "$file" >&2; rm -f "$snap"; exit 2; }
# shellcheck disable=SC2329  # invoked indirectly via the EXIT trap below
restore() { cp "$snap" "$file"; rm -f "$snap"; }
trap restore EXIT   # restore on ANY exit path — a broken file must never leak out

# Baseline FIRST: the test MUST be green on clean code. Without this, a test that's red for a
# reason unrelated to the break — a typo'd/missing command (exit 127), wrong cwd, an already-broken
# test — would fail against the mutated file and be falsely stamped `mutation-proven`. That is the
# exact false negative-control this step exists to prevent: "proving" a test can fail when it just
# can't run. A merge-gate credibility hole, since the marker backs test-quality:PASS.
if ! "$@" >/dev/null 2>&1; then
  printf 'mutation-check: test is NOT green on clean code — a failure cannot be attributed to the mutation\n' >&2
  exit 2
fi

before="$(cksum < "$file")"
sed -i.bak -e "$expr" "$file" && rm -f "$file.bak"
after="$(cksum < "$file")"
[ "$before" != "$after" ] || { printf 'mutation-check: sed expression changed nothing — not a real mutation\n' >&2; exit 2; }

# Run the test against the MUTATED file. We WANT it to fail.
if "$@" >/dev/null 2>&1; then
  printf 'mutation-check: test STILL PASSED on mutated code — the test cannot detect this break (false test)\n' >&2
  exit 1
fi
printf 'mutation-proven: RED\n'
exit 0
