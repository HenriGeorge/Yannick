{
  "enabledPlugins": {
    "ponytail@ponytail": false,
    "superpowers@claude-plugins-official": false,
    "superpowers@superpowers-dev": false,
    "ct-core@claude-template": true,
    "ct-hooks-py@claude-template": true
  },
  "extraKnownMarketplaces": {
    "claude-template": {
      "source": {
        "source": "github",
        "repo": "HenriGeorge/claude_template"
      },
      "autoUpdate": true
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || exit 0; [ -f \"$CLAUDE_PROJECT_DIR\"/scripts/cloud-materialize.sh ] || exit 0; bash \"$CLAUDE_PROJECT_DIR\"/scripts/cloud-materialize.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || exit 0; [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_start.py ] || exit 0; python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_start.py"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || exit 0; [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/figma_launch.py ] || exit 0; python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/figma_launch.py",
            "async": true
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || exit 0; [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/cloud_session.py ] || exit 0; python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/cloud_session.py"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || exit 0; [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_autoff.py ] || exit 0; python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_autoff.py"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || exit 0; [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rules_refresh.py ] || exit 0; python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rules_refresh.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Agent|Task|Write|Edit|NotebookEdit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || exit 0; [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre_tool.py ] || exit 0; python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre_tool.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || exit 0; [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rtk_rewrite.py ] || exit 0; python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rtk_rewrite.py"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || exit 0; [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr_gate.py ] || exit 0; python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr_gate.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || exit 0; [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post_tool_use_lint.py ] || exit 0; python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post_tool_use_lint.py"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || exit 0; [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/telemetry.py ] || exit 0; python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/telemetry.py"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || exit 0; [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_crumb.py ] || exit 0; python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_crumb.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || exit 0; [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop_record.py ] || exit 0; python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop_record.py"
          }
        ]
      }
    ],
    "SubagentStop": [],
    "WorktreeCreate": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || exit 0; [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/worktree_create.py ] || exit 0; python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/worktree_create.py",
            "timeout": 120
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || exit 0; [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/worktree_remove.py ] || exit 0; python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/worktree_remove.py"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || exit 0; [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/teammate_idle.py ] || exit 0; python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/teammate_idle.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "clear|other",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || exit 0; [ -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_crumb.py ] || exit 0; python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_crumb.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(bin/test-lock *)",
      "Bash(rtk *)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep"
    ]
  }
}
