#!/usr/bin/env bash
# bin/run-py-hook — resolve a Python >=3.11 interpreter and exec a hook through it (#764).
#
# WHY: the python-stack scaffold wired every hook as `uv run <hook>.py`, paying uv's
# dependency-resolution startup tax on EVERY hook invocation. Bare `python3` is NOT a safe swap —
# it is 3.9 on some machines, and the hooks declare `requires-python >=3.11` and use PEP-604
# (`str | None`) unions that throw at def-time under 3.9. This shim resolves a real 3.11+ interpreter
# (mirroring the proven resolver in tests/lib/assert.sh's run_py_hook), and falls back to
# `uv run --script` (which honours the shebang's requires-python) only when no python3.x is on PATH.
#
# exec (never a subshell) so stdin, args, exit code, stdout, and stderr pass through UNCHANGED.
# Override: PY_HOOK_BIN=<interpreter> forces a specific one (same env var the test lib honours).
# Dependency-free; bash 3.2 (macOS).
set -u
# A MISSING hook file is skipped, never fatal (hook-consolidation spec C1): `python3 missing.py`
# exits 2, which Claude Code reads as a PreToolUse BLOCK on every tool call. A retired or
# not-yet-installed hook must degrade to "that hook is off, and here is why".
case "${1:-}" in
  *.py)
    if [ ! -f "$1" ]; then
      _rph_name="$(basename "$1" | tr -cd 'A-Za-z0-9_.-')"
      _rph_msg="hook $_rph_name not found — skipped (retired or not installed); run setup.sh --update-hooks"
      echo "$_rph_msg" >&2
      _rph_proj="${CLAUDE_PROJECT_DIR:-$PWD}"
      # Once per hook per session: a retired-but-still-wired hook fires on EVERY tool call, so the
      # user-visible warning (stdout systemMessage — exit-0 stderr is not shown) and the telemetry
      # line are deduped by a session marker.
      _rph_sid="$({ [ -t 0 ] || cat; } 2>/dev/null | tr -d '\n' | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([A-Za-z0-9_-]*\)".*/\1/p')"
      _rph_mark="$_rph_proj/.claude/state/hook-missing/$_rph_name.${_rph_sid:-nosession}"
      [ -e "$_rph_mark" ] && exit 0
      mkdir -p "$(dirname "$_rph_mark")" 2>/dev/null && : > "$_rph_mark" 2>/dev/null
      printf '{"systemMessage":"%s"}\n' "$_rph_msg"
      _rph_env="$(printf '%s' "${CLAUDE_TELEMETRY:-}" | tr '[:upper:]' '[:lower:]')"
      _rph_off=0
      case "$_rph_env" in
        0|false|no|off) _rph_off=1 ;;
        "") grep -qiE '^TELEMETRY=(0|false|no|off)([[:space:]]|$)' "$_rph_proj/.claude/worktrees.conf" 2>/dev/null && _rph_off=1 ;;
      esac
      if [ "$_rph_off" = 0 ] && [ -d "$_rph_proj/.claude" ]; then
        mkdir -p "$_rph_proj/.claude/telemetry" 2>/dev/null &&
          printf '{"ts":%s,"event":"HookMissing","hook":"%s","exit":0,"decision":"skip","reason_class":"hook-missing"}\n' \
            "$(date +%s)" "${_rph_name%.py}" >> "$_rph_proj/.claude/telemetry/hook-events.jsonl" 2>/dev/null
      fi
      exit 0
    fi ;;
esac
for _c in "${PY_HOOK_BIN:-}" python3.13 python3.12 python3.11; do
  [ -n "$_c" ] || continue
  if command -v "$_c" >/dev/null 2>&1; then exec "$_c" "$@"; fi
done
command -v uv >/dev/null 2>&1 && exec uv run --script "$@"
exec python3 "$@"   # last resort: a 3.11-default box with none of the above still runs
